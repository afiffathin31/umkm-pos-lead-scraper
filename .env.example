# Telegram Bot Configuration
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Whitelist Telegram Chat ID yang diizinkan menggunakan bot (pisahkan dengan koma jika lebih dari satu)
# Contoh: ALLOWED_CHAT_IDS=123456789,987654321
# Jika dikosongkan, bot dapat diakses siapa saja (tidak disarankan untuk production)
ALLOWED_CHAT_IDS=

# Konfigurasi Scraper
HEADLESS_MODE=true
DEFAULT_MAX_LIMIT=30
BROWSER_TIMEOUT_MS=60000
